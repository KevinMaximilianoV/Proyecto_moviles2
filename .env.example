# Copia este archivo como .env (junto a docker-compose.yml) y cambia los valores.

# Contraseñas de MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_USER=blog_api
DB_PASSWORD=cambia-esta-clave

# Clave para firmar los tokens JWT (mínimo 32 caracteres).
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Duración de la sesión en minutos (720 = 12 horas)
MINUTOS_TOKEN=720

# Puertos expuestos en la máquina anfitriona
API_PORT=8000
MYSQL_PORT=3307
